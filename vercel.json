{
    "version": 2,
    "builds": [
        {
            "src": "index.js",
            "use": "@vercel/node"
        },
        {
            "src": "openapi.json",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/openapi.json",
            "dest": "/openapi.json"
        },
        {
            "src": "/(.*)",
            "dest": "index.js"
        }
    ]
}
